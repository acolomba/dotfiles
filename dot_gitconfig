[core]
    pager = delta

[delta]
    navigate = true

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictStyle = zdiff3

[init]
	defaultBranch = main

[fetch]
	prune = true
[push]
	autoSetupRemote = true

[log]
	date = local

[user]
	useConfigOnly = true

[include]
	path = ~/.gitconfig-local
