{{- /* prefers homebrew's fish, then any fish on PATH */ -}}
{{- $fish := lookPath "fish" -}}
{{- if lookPath "brew" -}}
{{-   $brewPrefix := output "brew" "--prefix" | trim -}}
{{-   if stat (printf "%s/bin/fish" $brewPrefix) -}}
{{-     $fish = printf "%s/bin/fish" $brewPrefix -}}
{{-   end -}}
{{- end -}}

onboarding = false

[theme]
dark_name = "one-dark"
light_name = "one-light"

[terminal]
{{- if $fish }}
default_shell = "{{ $fish }}"
{{- end }}

[keys]
prefix = "ctrl+a"

[ui]
copy_on_select = false

[ui.toast]
delivery = "terminal"
