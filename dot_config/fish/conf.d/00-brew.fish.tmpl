{{- $bazzite := false -}}
{{- $truenas := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $bazzite = eq (dig "id" "" .chezmoi.osRelease) "bazzite" -}}
{{-   $truenas = and (eq (dig "id" "" .chezmoi.osRelease) "debian") (contains "truenas" (dig "osrelease" "" .chezmoi.kernel)) -}}
{{- end -}}
# homebrew
{{- if eq .chezmoi.os "darwin" }}
eval $(/opt/homebrew/bin/brew shellenv fish)
set -gx HOMEBREW_NO_ASK 1
{{- else if $bazzite }}
# Bazzite: keep brew after system binaries, like /etc/profile.d/brew.sh
eval $(/home/linuxbrew/.linuxbrew/bin/brew shellenv fish | string match --invert --regex '^fish_add_path')
fish_add_path --global --append --path $HOMEBREW_PREFIX/bin $HOMEBREW_PREFIX/sbin
set -gx HOMEBREW_NO_ASK 1
{{- else if $truenas }}
# TrueNAS: homebrew lives in the home dir; keep it after system binaries
eval $(~/.brew/bin/brew shellenv fish | string match --invert --regex '^fish_add_path')
fish_add_path --global --append --path $HOMEBREW_PREFIX/bin $HOMEBREW_PREFIX/sbin
set -gx HOMEBREW_NO_ASK 1
{{- else }}
if test -x /home/linuxbrew/.linuxbrew/bin/brew
    eval $(/home/linuxbrew/.linuxbrew/bin/brew shellenv fish)
    set -gx HOMEBREW_NO_ASK 1
end
{{- end }}
