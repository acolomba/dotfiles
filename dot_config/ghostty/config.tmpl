{{- /* Homebrew zsh, system zsh, then Ghostty's default shell */ -}}
{{- $shell := "" -}}
{{- if lookPath "brew" -}}
{{-   $brewPrefix := output "brew" "--prefix" | trim -}}
{{-   if stat (printf "%s/bin/zsh" $brewPrefix) -}}
{{-     $shell = printf "%s/bin/zsh" $brewPrefix -}}
{{-   end -}}
{{- end -}}
{{- if eq $shell "" -}}
{{-   if stat "/opt/homebrew/bin/zsh" -}}
{{-     $shell = "/opt/homebrew/bin/zsh" -}}
{{-   else if stat "/usr/local/bin/zsh" -}}
{{-     $shell = "/usr/local/bin/zsh" -}}
{{-   else if stat "/home/linuxbrew/.linuxbrew/bin/zsh" -}}
{{-     $shell = "/home/linuxbrew/.linuxbrew/bin/zsh" -}}
{{-   end -}}
{{- end -}}
{{- if eq $shell "" -}}
{{-   if stat "/bin/zsh" -}}
{{-     $shell = "/bin/zsh" -}}
{{-   else if stat "/usr/bin/zsh" -}}
{{-     $shell = "/usr/bin/zsh" -}}
{{-   end -}}
{{- end -}}

# font
font-family = Monaspace Neon NF
font-style = Medium
font-style-bold = SemiBold
font-size = 12
adjust-cell-width = -10%

# theme
theme = "light:Monokai Pro Light Sun,dark:0x96f"

# shell
{{- if $shell }}
command = {{ $shell }} --login --interactive
{{- end }}
shell-integration-features = no-cursor,ssh-terminfo

# window
working-directory = home
window-inherit-working-directory = false
window-theme = system
window-height = 40
window-width = 132
window-show-tab-bar = always

# keybinds
keybind = cmd+shift+zero=reset_window_size

# behavior
copy-on-select = false
auto-update = download

# macos
macos-titlebar-style = native
desktop-notifications = true
