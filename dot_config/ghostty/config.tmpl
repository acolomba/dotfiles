{{- /* prefers homebrew's fish, then any fish on PATH, then ghostty's default */ -}}
{{- $brewPrefix := "" -}}
{{- if lookPath "brew" -}}
{{-   $brewPrefix = trimSuffix "/bin/brew" (lookPath "brew") -}}
{{- else -}}
{{-   range (list "/opt/homebrew" "/usr/local" "/home/linuxbrew/.linuxbrew") -}}
{{-     if and (eq $brewPrefix "") (stat (printf "%s/bin/brew" .)) -}}
{{-       $brewPrefix = . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $fish := "" -}}
{{- if and (ne $brewPrefix "") (stat (printf "%s/bin/fish" $brewPrefix)) -}}
{{-   $fish = printf "%s/bin/fish" $brewPrefix -}}
{{- else -}}
{{-   $fish = lookPath "fish" -}}
{{- end -}}
{{ if $fish }}command = {{ $fish }} --login --interactive

{{ end -}}
# behavior
auto-update = download
copy-on-select = false

# font
font-size = 12
font-family = FiraCode Nerd Font Mono
font-style = Retina
font-style-bold = SemiBold
font-thicken = true
font-thicken-strength = 100
adjust-cell-width = -10%
adjust-cell-height = 0%

# keybinds
keybind = cmd+shift+zero=reset_window_size

# macos
macos-titlebar-style = native
desktop-notifications = true

# shell
shell-integration-features = no-cursor,ssh-terminfo

# theme
theme = "light:Monokai Pro Light Sun,dark:0x96f"

# window
window-show-tab-bar = always
window-theme = system
window-height = 40
window-width = 132
window-inherit-working-directory = false
working-directory = home
