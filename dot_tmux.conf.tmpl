# C-a as in screen
unbind C-b
set -g prefix C-a
bind a send-prefix

# window navigation
bind C-a last-window
bind Space next-window
bind BSpace previous-window

{{- /* Homebrew zsh, system zsh, then tmux's default shell */ -}}
{{- $shell := "" -}}
{{- if lookPath "brew" -}}
{{-   $brewPrefix := output "brew" "--prefix" | trim -}}
{{-   if stat (printf "%s/bin/zsh" $brewPrefix) -}}
{{-     $shell = printf "%s/bin/zsh" $brewPrefix -}}
{{-   end -}}
{{- end -}}
{{- if eq $shell "" -}}
{{-   if stat "/opt/homebrew/bin/zsh" -}}
{{-     $shell = "/opt/homebrew/bin/zsh" -}}
{{-   else if stat "/usr/local/bin/zsh" -}}
{{-     $shell = "/usr/local/bin/zsh" -}}
{{-   else if stat "/home/linuxbrew/.linuxbrew/bin/zsh" -}}
{{-     $shell = "/home/linuxbrew/.linuxbrew/bin/zsh" -}}
{{-   end -}}
{{- end -}}
{{- if eq $shell "" -}}
{{-   if stat "/bin/zsh" -}}
{{-     $shell = "/bin/zsh" -}}
{{-   else if stat "/usr/bin/zsh" -}}
{{-     $shell = "/usr/bin/zsh" -}}
{{-   end -}}
{{- end -}}
{{- if $shell }}

# shell
set-option -g default-shell {{ $shell }}
{{- end }}

# escape sequence passthrough (e.g. notifications)
set -g allow-passthrough on

# focus
set -g focus-events on

# mouse
set -g mouse

# extended keys (for shift-enter in claude code, etc.)
set -s extended-keys on
set -s extended-keys-format csi-u
set -as terminal-features 'xterm*:extkeys'

# window/pane indexes start at 1
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
