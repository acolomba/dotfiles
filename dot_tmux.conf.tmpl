# C-a as in screen
unbind C-b
set -g prefix C-a
bind a send-prefix

# window navigation
bind C-a last-window
bind Space next-window
bind BSpace previous-window

{{- /* prefers homebrew's fish, then any fish on PATH */ -}}
{{- $fish := "" -}}
{{- if lookPath "brew" -}}
{{-   $brewPrefix := output "brew" "--prefix" | trim -}}
{{-   if stat (printf "%s/bin/fish" $brewPrefix) -}}
{{-     $fish = printf "%s/bin/fish" $brewPrefix -}}
{{-   end -}}
{{- end -}}
{{- if eq $fish "" -}}
{{-   $fish = lookPath "fish" -}}
{{- end -}}
{{- if $fish }}

#shell
set-option -g default-shell {{ $fish }}
{{ else }}
{{ end }}
# escape sequence passthrough (e.g. notifications)
set -g allow-passthrough on

# focus
set -g focus-events on

# mouse
set -g mouse

# extended keys (for shift-enter in claude code, etc.)
set -s extended-keys on
set -s extended-keys-format csi-u
set -as terminal-features 'xterm*:extkeys'

# window/pane indexes start at 1
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
