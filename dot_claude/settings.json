{
  "agentPushNotifEnabled": true,
  "autoDreamEnabled": true,
  "autoUpdatesChannel": "stable",
  "enabledPlugins": {},
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "outputStyle": "Concise",
  "permissions": {
    "defaultMode": "auto"
  },
  "pluginConfigs": {},
  "promptSuggestionEnabled": false,
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 15,
    "type": "command"
  },
  "theme": "auto",
  "tui": "fullscreen"
}
