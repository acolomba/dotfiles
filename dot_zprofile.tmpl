{{- $bazzite := false -}}
{{- $truenas := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $bazzite = eq (dig "id" "" .chezmoi.osRelease) "bazzite" -}}
{{-   $truenas = and (eq (dig "id" "" .chezmoi.osRelease) "debian") (contains "truenas" (dig "osrelease" "" .chezmoi.kernel)) -}}
{{- end -}}
# homebrew
{{- if eq .chezmoi.os "darwin" }}
eval "$(/opt/homebrew/bin/brew shellenv zsh)"
export HOMEBREW_NO_ASK=1
{{- else if $bazzite }}
# Bazzite: keep brew after system binaries, like /etc/profile.d/brew.sh
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh | grep -v '^export PATH=')"
typeset -U path
path+=("$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin")
export HOMEBREW_NO_ASK=1
{{- else if $truenas }}
# TrueNAS: homebrew lives in the home dir; keep it after system binaries
eval "$(~/.brew/bin/brew shellenv zsh | grep -v '^export PATH=')"
typeset -U path
path+=("$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin")
export HOMEBREW_NO_ASK=1
{{- else }}
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
    export HOMEBREW_NO_ASK=1
fi
{{- end }}
